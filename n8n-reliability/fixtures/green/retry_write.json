{
  "name": "Order to CRM",
  "nodes": [
    {
      "id": "a1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "parameters": {
        "path": "order"
      }
    },
    {
      "id": "a3",
      "name": "Dedupe",
      "type": "n8n-nodes-base.removeDuplicates",
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "dedupeValue": "={{$json.order_id}}"
      }
    },
    {
      "id": "a2",
      "name": "Create deal",
      "type": "n8n-nodes-base.httpRequest",
      "retryOnFail": true,
      "maxTries": 3,
      "parameters": {
        "method": "POST",
        "url": "https://crm.example.test/deals",
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{$json.order_id}}"
            }
          ]
        },
        "sendHeaders": true
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Dedupe",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dedupe": {
      "main": [
        [
          {
            "node": "Create deal",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "errorWorkflow": "99"
  }
}